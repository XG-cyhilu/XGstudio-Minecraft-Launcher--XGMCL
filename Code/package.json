{
  "name": "XGstudio-Minecraft-Launcher",
  "version": "2602.01.02",
  "author": "XGstudio_O_C_XG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@dpawlikowski/liquid-glass": "^0.3.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "iconv-lite": "^0.6.3",
    "sharp": "^0.33.5",
    "systeminformation": "^5.33.15",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.xgstudio.xgmcl",
    "productName": "XGMCL",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "bs_preload.js",
      "index.html",
      "bs.html",
      "splash.html",
      "style.css",
      "package.json",
      "icon.png",
      "icon.ico",
      "paths.js",
      "config.js",
      "version.js",
      "systeminfo.js",
      "fabric.js",
      "java_scan.js",
      "java_deep_scan.js",
      "theme_pack.js",
      "xgmcl_log.js",
      "logs.js",
      "launcher.js",
      "download.js",
      "mojang.js",
      "fabric_install.js",
      "modrinth.js",
      "mods.js",
      "modpack.js",
      "server.js",
      "xg.js",
      "avatar.js",
      "upversion.js",
      "littleskin.js",
      "terminal.js",
      "loaders/**/*",
      "XGMCL/data/i18n/**/*",
      "XGMCL/data/lib/**/*"
    ],
    "win": {
      "icon": "icon.ico"
    },
    "extraResources": [
      {
        "from": "wiki_entries.json",
        "to": "wiki_entries.json"
      },
      {
        "from": "XGMCL/data/treasure_links.json",
        "to": "XGMCL/data/treasure_links.json"
      },
      {
        "from": "boot_files",
        "to": "boot_files"
      }
    ]
  }
}
